<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageProjectUrl>https://github.com/basilisque-framework/Consumer.Framework</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Basilisque.CommonFrameworkBuild" GeneratePathProperty="true" />
  </ItemGroup>
  <Target Name="CaptureFixtureProperties" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="BAS_CB_SetVersionProperties">
    <ItemGroup>
      <AssemblyMetadata Include="RootNamespace" Value="$(RootNamespace)" />
      <AssemblyMetadata Include="Authors" Value="$(Authors)" />
      <AssemblyMetadata Include="PackageId" Value="$(PackageId)" />
      <AssemblyMetadata Include="PackageVersion" Value="$(PackageVersion)" />
      <AssemblyMetadata Include="PackageReleaseNotes" Value="$(PackageReleaseNotes)" />
      <AssemblyMetadata Include="PackageLicenseExpression" Value="$(PackageLicenseExpression)" />
      <AssemblyMetadata Include="PackageRequireLicenseAcceptance" Value="$(PackageRequireLicenseAcceptance)" />
      <AssemblyMetadata Include="Nullable" Value="$(Nullable)" />
      <AssemblyMetadata Include="ImplicitUsings" Value="$(ImplicitUsings)" />
      <AssemblyMetadata Include="GenerateDocumentationFile" Value="$(GenerateDocumentationFile)" />
      <AssemblyMetadata Include="FrameworkBuildPackagePath" Value="$(PkgBasilisque_CommonFrameworkBuild)" />
      <AssemblyMetadata Include="FixtureProjectPath" Value="$(MSBuildProjectFullPath)" />
      <AssemblyMetadata Include="FixtureAssetsPath" Value="$(ProjectAssetsFile)" />
      <AssemblyMetadata Include="ArtifactsPath" Value="$(ArtifactsPath)" />
      <AssemblyMetadata Include="Configuration" Value="$(Configuration)" />
    </ItemGroup>
  </Target>
</Project>